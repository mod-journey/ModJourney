/world/deaths
!/craftpresence




!/defaultconfigs/
!/defaultconfigs/*
#!/world/datapacks/
#!/world/serverconfig/
#!/world/serverconfig/*

# Dont ignore git meta-files
!/.gitignore
!/.gitattributes
!README.md


# Dont ignore dev-tools
!/dev-tools/
/dev-tools/logs/*

# Always ignore Tempfiles and OS generated stuff
.DS_Store
[Tt]humbs.db
[Dd]esktop.ini
*.old
*.dat_old
*.bak

# ignore files that should be autogenerated on each start of the pack
/config/worldedit/.archive-unpack/
/config/luckperms/translations/
/config/luckperms/libs/
kubejs/config/client.json
kubejs/config/common.json
kubejs/config/web_server.json


# Ignore files containing user specific config
/config/voicechat/username-cache.json
/config/ItemLocks/nodes/SP/
/config/jei/world/local/
/config/worldedit/sessions/
/config/jei-client.ini
/config/ftbchunks-client.snbt
/config/justzoom/config.txt

#This files always changed their order
/config/jade/sort-order.json
/config/powah.json5


# Ignore ProbeJS Generated Files
.probe
jsconfig.json
probe-settings.json


