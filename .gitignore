/*
!/kubejs/
!/config/
/config/luckperms/luckperms-h2-v2.mv.db
/config/libraryferret_1.properties
/config/bettervillage_1.properties
/config/worldedit/worldedit.properties
/config/luckperms/*
/config/spark/*
!/world/
/world/advancements/
/world/data
/world/DIM*
/world/dimensions
/world/entities
/world/ftb*
/world/playerdata
/world/poi
/world/region
/world/serverconfig
/world/stats
/world/kubejs_persistent_data.nbt
/world/level.*
