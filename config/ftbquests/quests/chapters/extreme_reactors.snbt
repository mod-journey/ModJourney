			x: 0.0d
			y: 3.0d
		}
		{
			description: ["Die Access Ports sind die Zugangspunkte zum Reaktor. Diese kannst Du Rechtsklicken. In der GUI kannst Du einstellen, ob dieser als Eingabe- oder Ausgabepunkt dienen soll. Außerdem kannst Du hier manuell triggern, ob dieser In- oder Output Material ausgeben soll. Die Ausgabe erfolgt in Fester Form, also als Ingot."]
			icon: "bigreactors:reinforced_reactorsolidaccessport"
			id: "66DEEA92B5F386C0"
			tasks: [{
				id: "5FC19862AC343856"
				item: {
					Count: 1
					id: "itemfilters:or"
					tag: {
						items: [
							{
								Count: 1b
								id: "bigreactors:reinforced_reactorsolidaccessport"
							}
							{
								Count: 1b
								id: "bigreactors:basic_reactorsolidaccessport"
							}
						]
					}
				}
				title: "Access Ports"
				type: "item"
			}]
			title: "Any Access Port"
			x: -2.5d
			y: 5.0d
		}
		{
			description: ["Du kannst hiermit deinen Reaktor verwandeln in einen aktiv gekühlten Reaktor. Somit generierst du Dampf. Diesen kannst Du nutzen um eine Turbine zu betreiben. Du brauchst 2 dieser Ports. Auch hier kannst Du definieren, dass es sich um ein Eingangs- oder Ausgangsport handelt. "]
			id: "646646E999822E90"
			tasks: [{
				id: "2FFC4BAF4B3382CF"
				item: "bigreactors:reinforced_reactorfluidaccessport"
				type: "item"
			}]
			x: -3.5d
			y: 5.0d
		}
		{
			description: ["Auch für die Turbine gibt es eine Basic Form. Mein Rat an der Stelle, solltet ihr in betracht ziehen über Extreme-Reactors Strom zu beziehen, baut direkt die Advanced Turbine. Spart Euch die Ressourcen. "]
			id: "4B86830BAFA84372"
			optional: true
			tasks: [{
				id: "70BF93F210FDF0DD"
				item: "bigreactors:basic_turbinecontroller"
				type: "item"
			}]
			x: 1.5d
			y: 3.5d
		}
		{
			description: ["Energy Ports sind die Schnittstelle für Energie. Hier kannst Du Energie aus dem Reaktor in dein Energienetzwerk einspeisen. Es gibt zwei Arten. Die Aktiven und Passiven Energy Ports. Der Unterschied liegt darin, dass man aktiv den Strom aus den passiven Ports rausziehen muss, während die aktiven versuchen diesen direkt an den Benachbarten Block abzugeben."]
			id: "21A66CAA4865D3D0"
			tasks: [{
				id: "68E959AF3630EE80"
				item: {
					Count: 1
					id: "itemfilters:or"
					tag: {
						items: [
							{
