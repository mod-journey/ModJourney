		}
		{
			dependencies: ["3BE9012B79628576"]
			description: ["Den Schablonenprovider gibt es ein mal in Flach und als Block. In diesen Block werden die Schablonen gelegt, welche Rezepte beinhalten. Außerdem hat der Schablonenprovider ein Rückgabe-Inventar. In der GUI auf der Linken Seite kann man außerdem Einstellen, ob Rezepte warten müssen, bis das Zielinventar leer ist, oder ob z.B. die Hauptzutat durch den Provider zurück in das ME gekommen ist. Außerdem kann man diesen auch konfigurieren, sodass dieser auf Redstonesignale hört."]
			id: "2FE06EF9861456E9"
			rewards: [{
				id: "37119402433DC20E"
				item: "mod_journey:bronze_coin"
				type: "item"
			}]
			tasks: [
				{
