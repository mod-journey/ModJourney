			}]
			x: -1.5d
			y: 2.0d
		}
		{
			dependencies: ["77D31EC2C76058E2"]
			description: ["Auch in Ars Nouveau gibt es eigene Holzarten, die für die verschiedensten Sachen benötigt werden. Die vier verschiedenen Archwood Baumarten sind überall in der Overworld zu finden. Jede von ihnen hat auch seine eigenen leckeren Früchte für die Frutarier unter euch."]
			id: "18DAE72E4F2B32E0"
			subtitle: "Magische Materialien für magische Werkzeuge"
