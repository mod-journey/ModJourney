	quests: [
		{
			description: [
				"Apotheosis bietet eine Vielzahl an verschiedenen Inhalten, um bestehende Vanilla Erfahrungen zu erweitern und auszubauen."
				""
				"Vom Enchanting Table über Minibosse zu legendären Waffen und Ausrüstungen ist alles dabei."
				""
				"Dieses Questbuch soll dich auf deine Reise durch Apotheosis begleiten und Schritt für Schritt deinen Progress voranbringen."
			]
			id: "736169731670410F"
			shape: "hexagon"
			subtitle: "Willkommen bei Apotheosis"
			tasks: [{
				id: "5EB18BF4940B6540"
				title: "Magie, Adventure, Utility"
				type: "checkmark"
			}]
