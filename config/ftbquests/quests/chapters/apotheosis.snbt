	quest_links: [ ]
	quests: [
		{
			description: [
				"Apotheosis bietet eine Vielzahl an verschiedenen Inhalten, um bestehende Vanilla Erfahrungen zu erweitern und auszubauen."
				""
				"Vom Enchanting Table über Minibosse zu legendären Waffen und Ausrüstungen ist alles dabei."
				""
				"Dieses Questbuch soll dich auf deine Reise durch Apotheosis begleiten und Schritt für Schritt deinen Progress voranbringen."
			]
			id: "736169731670410F"
			shape: "hexagon"
			subtitle: "Willkommen bei Apotheosis"
			tasks: [{
				id: "54E4A312D7912534"
				item: {
					Count: 1
					id: "patchouli:guide_book"
					tag: {
						"patchouli:book": "apotheosis:apoth_chronicle"
					}
				}
				type: "item"
			}]
			title: "Magie, Adventure, Utility"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["736169731670410F"]
			description: [
				"Dieses Modul von Apotheosis bringt für die Kämpfer unter euch viele Zusätze mit sich."
				""
				"So gibt es viele Modifikationen für Waffen, Tools und Rüstungen, Minibosse und mehr!"
				""
				"Das Questbuch fokussiert sich darauf, euch durch die Modifizierungsprozesse für die Ausrüstung zu führen."
				""
				"Informationen zu Bossmechaniken etc. findet ihr im \"Chronical of Shadows\" Buch."
			]
			icon: {
				Count: 1
				id: "minecraft:netherite_sword"
				tag: {
					Damage: 0
				}
			}
			id: "52E3890CD233C42D"
			tasks: [{
				id: "3EFD7BC8486F976A"
				title: "Adventure"
				type: "checkmark"
			}]
			x: 0.0d
			y: -2.0d
		}
		{
			dependencies: ["736169731670410F"]
			description: [
				"Das wohl größte und umfangreichste Modul in Apotheosis. Dieses Modul verändert die Verwendung des Enchanting Tables von Grund auf."
				""
				"Neue Bücherregale, Mechaniken, Items etc."
				"{@pagebreak}"
				"Enchanting Table GUI und Bücherregal Stats:"
				""
				"-&2Eterna&r: Erhöht das maximale Verzauberungslevel."
				""
				"-&cQuanta&r: Erhöht die Breite an zufällig ausgewählten Verzauberungen. &eRectification&r verringert das Aufkommen negativer Effekte."
				""
				"-&5Arcana&r: Erhöht die Wahrscheinlichkeit für seltenere Verzauberungen und die Anzahl an Verzauberungen."
				""
				"-&3Enchanting Clues&r: Anzahl an Verzauberungen, die die Vorschau offenbart."
				""
				""
				"Verzauberungsvorgänge brauchen in der Regel eine gewisse Mindestmenge an &2Eterna&r, &cQuanta&r und &5Arcana&r. Manche haben dabei sogar eine Maximalmenge, die nicht überschritten werden darf."
				""
				"&nAchte dafür auf die Rezepte im JEI!"
			]
			hide: false
			icon: "minecraft:enchanting_table"
			id: "209E7BD721F663CC"
			tasks: [{
				id: "77FAAC17DAF04807"
				title: "Enchanting"
				type: "checkmark"
			}]
			x: 0.0d
			y: 2.0d
		}
		{
			dependencies: ["736169731670410F"]
			description: [
				"Dieses Modul von Apotheosis erlaubt es, Mobspawner mit Silk Touch abzubauen, mitzunehmen und dann mit bestimmten Items zu modifizieren."
				""
				"Mit der \"Capturing\" Verzauberung können Spawneier von getöteten Mobs gedropt werden, mit denen man Spawner zu dem jeweiligen Mob ändern kann."
				"{@pagebreak}"
				"&6-&rSoul Lantern: Ignoriert Licht, Mobs spawnen trotz Licht."
				""
				"&6-&rFermented Spider Eye: +1 Spawn Count"
				"Anzahl an Mobs, die pro Spawnvorgang auftauchen"
				""
				"&6-&rGhast Tear: +2 Max Entities"
				"maximale Anzahl dieses Mobs, die gleichzeitig vorhanden sein darf"
				""
				"&6-&rWool: Silent"
				"Mobs machen keine Geräusche mehr"
				""
				"&6-&rChorus Fruit: No AI"
				"Mobs haben keine KI mehr, können weder angreifen noch sich bewegen"
				""
				"&6-&rSugar: -10 Min Spawn Delay"
				"Mindestzeit zum nächsten Spawnvorgang"
				""
				"&6-&rPrismarin Crystals: +2 Activation Range"
				"Reichweite, in der ein Spieler vorhanden sein muss zum Spawnen"
				""
				"&6-&rTurtle Egg: Baby Variant"
				"spawnt nur noch Babymobs"
				""
				"&6-&rRedstone Comparator: Redstone Control"
				"Spawner per Redstone ein- und ausschaltbar"
				""
				"&6-&rClock: -10 Max Spawn Delay"
				"Höchstzeit zum nächsten Spawnvorgang"
				""
				"&6-&rDragon Egg: Ignoriert Spawnbedingungen"
				"Beispiel: Grasblockboden für Tiere, Lichtverhältnisse etc."
				""
				"&6-&rBlaze Rod: +1 Spawn Range"
				"Reichweite, in der Mobs um den Spawner herum auftauchen"
				""
				"&6-&rNether Quartz (Offhand): Gegenteiliger Effekt"
				"kehrt Effekte oben genannter Items um"
			]
			icon: "minecraft:spawner"
			id: "439A11FC8B1BE52A"
			tasks: [{
				id: "470552CCC5DF54DE"
				title: "Spawner"
				type: "checkmark"
			}]
			x: -2.0d
			y: -1.0d
		}
		{
			dependencies: ["736169731670410F"]
			description: [
				"Dieses Modul von Apotheosis bringt neue Trankeffekte und -rezepte mit sich. Außerdem kann man sich Potion Charms craften, die ein- und ausschaltbar sind und ihre Trankeffekte über einen längeren Zeitraum nutzbar machen, solange sie im Inventar oder einem Charm-Slot von Curio sind."
				""
				"{@pagebreak}"
				"Neue Effekte:"
				""
				"&6-&rAncient Knowledge: Erhöht Erfahrung von Mobs (Stufe I: 5x; Stufe II: 17x)"
				""
				"&6-&rBursting Vitality: Verstärkt heilende Effekte (20% pro Stufe)"
				""
				"&6-&rGrievous Wounds: Schwächt heilende Effekte (40% pro Stufe, Stufe III verhindert Heilungen)"
				""
				"&6-&rSundering: Erhöht erlittenen Schaden (20% pro Stufe), addiert sich mit Resistance"
				""
				"&6-&rBleeding: Alle 2 Sekunden wird Schaden erlitten, Schaden steigt mit Stufe, ignoriert Rüstung."
				"{@pagebreak}"
				"Neue Rezepte:"
				""
				"&6-&rAbsorption: Gibt temporäre Herzen (2 pro Stufe)"
				""
				"&6-&rLuck: Verbessert Loot aus bestimmten Quellen (Bsp. Angeln)"
				""
				"&6-&rMining Fatigue: Verlangsamt Schlag- und Abbaugeschwindigkeit (20% pro Stufe)"
				""
				"&6-&rResistance: Verringert erlittenen Schaden (20% pro Stufe)"
				""
				"&6-&rWither: Passiver Schaden (wie Gift) im Wirkungszeitraum, der tödlich sein kann"
				""
				"&6-&rHaste: Erhöht Schlag- und Abbaugesschwindigkeit (20% pro Stufe)"
			]
			icon: {
				Count: 1
				id: "minecraft:potion"
				tag: {
					Potion: "minecraft:strong_healing"
				}
			}
			id: "0DE688D34731681F"
			tasks: [{
				id: "1CD049F99BFEF2DA"
				title: "Potions"
				type: "checkmark"
			}]
			x: 2.0d
			y: -1.0d
		}
