		}
		{
			dependencies: ["644466781495F7E7"]
			description: ["Runen stellen ein weiteres wichtiges Utensil in der arkanen Kunst der dunklen Magie da. Die erste der vielen Runen wird wohl mit normalen Steinen im Blut Altar hergestellt. Probier es doch mal direkt aus. "]
			id: "5687ACBB8EDE2C51"
			rewards: [{
				exclude_from_claim_all: true
				id: "51B7616C05DD7BBE"
				table_id: 4479814402924041300L
				type: "loot"
			}]
			subtitle: "Die erste von vielen."
			tasks: [{
				id: "48E454E00B4D24EC"
				item: "bloodmagic:blankslate"
				type: "item"
			}]
			title: "Eine Rune- Nein ein blanke Rune"
			x: -1.5d
			y: 0.0d
		}
		{
			dependencies: [
				"7595DD9DE29C0C44"
				"5687ACBB8EDE2C51"
			]
			description: ["Eine Rune benutzt Du um dein Blutaltar zu vergrößern. Im Blood Magic Guide Book wirst Du zu diesen komplexen Strukturen bestimmt fündig. Den überlieferungen zu folge, soll der erste Blood Altar aus 8 weiteren Blanken Runensteinen bestehen."]
			id: "413828EBD4CE1AA8"
			rewards: [{
				exclude_from_claim_all: true
				id: "2B936AF80943EC1A"
				table_id: 4479814402924041300L
				type: "loot"
			}]
			subtitle: "Slates != Rune"
			tasks: [{
				id: "37DB6D5328C6481B"
				item: "bloodmagic:blankrune"
				type: "item"
			}]
			title: "Deine erste Runen"
			x: 0.0d
			y: 1.5d
		}
		{
			dependencies: ["644466781495F7E7"]
			description: ["Natürlich braucht es Speicher. Eine bessere Methode Blut zu speichern stellt der Blut Orb da. Dieser bildet sein eigenes Netzwerk und ist gänzlich für neue Mythen und Rituale nutzbar. Auch einige antike Rezepte sollen mit dem Orb als Katalyst funktionieren. Wenn man den Gelehrten glauben schenken darf, so füllt sich dieser im Blut Altar auf."]
			id: "7595DD9DE29C0C44"
			rewards: [{
				exclude_from_claim_all: true
				id: "4441469E0EF46B03"
				table_id: 4479814402924041300L
				type: "loot"
			}]
			subtitle: "Welcher kühne Magier hat auch keinen?"
			tasks: [{
				id: "5FFD0112B1E96B7B"
				item: "bloodmagic:weakbloodorb"
				type: "item"
			}]
			title: "Natürlich ist es ein Orb"
			x: 1.5d
			y: 0.0d
		}
		{
			dependencies: ["7595DD9DE29C0C44"]
			description: ["Mittels diesem Item, welches du in die nähe von deinem Altar stellst, kannst Du dich durch Selbstblutentnahme nicht mehr töten. Auch hierfür gibt es ein Multiblock in der zukunft. "]
			id: "775CA62679CED9AF"
			rewards: [{
				exclude_from_claim_all: true
				id: "1558AA6EC79D269D"
				table_id: 4479814402924041300L
				type: "loot"
			}]
			subtitle: "Ein bisschen mehr Sicherheit"
			tasks: [{
				id: "069F0D25DFCC2AA6"
				item: "bloodmagic:incensealtar"
				type: "item"
			}]
			x: 3.0d
			y: 1.5d
		}
		{
			dependencies: ["413828EBD4CE1AA8"]
			description: ["Mit einem nun besseren Blut Altar lässt sich ein noch besserer Orb herstellen. Mit diesem werden bestimmt weitere Rezepte freigeschaltet."]
			id: "5F0DB83F6DED68A3"
			subtitle: "Natürlich, es folgen sogar noch mehr"
			tasks: [{
				id: "4640EF2068FEBE26"
				item: "bloodmagic:apprenticebloodorb"
				type: "item"
			}]
			title: "Noch ein Orb?"
			x: 0.0d
			y: 3.5d
		}
		{
			dependencies: ["5F0DB83F6DED68A3"]
			description: [
				"Neue Runenelemente wurden gefunden. Probiere doch mal gleich aus diese herzustellen. Sie sollen den Blut Altar signifikant verbessern."
				""
				"{@pagebreak}"
