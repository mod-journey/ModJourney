	order_index: 1
	quest_links: [ ]
	quests: [
		{
			dependencies: ["407F543ADE3A3EC3"]
			description: ["In Blood Magic dreht sich alles um den Blutaltar. Mittels diesen, ist es dir möglich neue Items zu erschaffen, welche Du über einen Rechtsklick in den Altar legst. Finden wir heraus, wie wir unser erstes Blut opfern."]
			hide: true
			id: "19ECDD38FF50B386"
			shape: "diamond"
			size: 1.5d
			subtitle: "Herzlich Willkommen in Blood Magic"
			tasks: [{
				id: "5D755300ED16321C"
				item: "bloodmagic:altar"
				type: "item"
			}]
			title: "Tier 1"
			x: 0.0d
			y: -5.5d
		}
		{
			dependencies: ["0DD2D5F39A7FC453"]
			description: ["Wenn Du nicht weißt wohin mit dem gesamten Blut, so kannst Du es in Eimer zwischen Speichern. Eine altbewährte Lagermethode. Du solltest Dir ein paar Eimer abschöpfen, villeicht kannst du diese später ja noch mal gebrauchen."]
			id: "644466781495F7E7"
			rewards: [{
				exclude_from_claim_all: true
				id: "3E7E545CF39A77DA"
				table_id: 4479814402924041300L
				type: "loot"
			}]
			shape: "gear"
			size: 1.5d
			subtitle: "Wohin mit dem ganzen Blut?"
			tasks: [{
				id: "5B8148FD2156F324"
				item: "bloodmagic:life_essence_bucket"
				type: "item"
			}]
			title: "Ein Eimer voller Blut"
			x: 0.0d
			y: -1.5d
		}
		{
			dependencies: ["19ECDD38FF50B386"]
			description: ["Mittels dem Messer können wir das erste Blut den alten Göttern opfern. Stelle dich neben den Altar und  drücke die Rechte Maustaste. Aber vorsicht, die Götter können nicht genug bekommen, nicht das Du zu viel her gibst. "]
			id: "0DD2D5F39A7FC453"
			subtitle: "Das erste Blutopfer"
			tasks: [{
